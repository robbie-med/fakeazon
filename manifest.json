{
  "manifest_version": 3,
  "name": "Fakeazon",
  "version": "0.1.0",
  "description": "Shop real Amazon, pay with a fake bank account. Real checkout is blocked.",
  "browser_specific_settings": {
    "gecko": {
      "id": "fakeazon@robbiemed.org",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.amazon.com/*"
  ],
  "background": {
    "scripts": [
      "lib/store.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Open Fakeazon Bank",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*"
      ],
      "js": [
        "lib/selectors.js",
        "content/amazon.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "css": [
        "content/amazon.css"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "checkout_block",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "blocked.css"
      ],
      "matches": [
        "*://*.amazon.com/*"
      ]
    }
  ]
}
